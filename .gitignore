docs/html
docs/tagfile.xml

*/bin/*
!*/bin/data/

# for bin folder in root
/bin/*
!/bin/data/

#########################
# example runtime / local state (do not commit)
#########################

# IDE / local debug helpers
.clangd
**/.clangd
.dbg_syntax.sh
**/.dbg_*.sh

# ImGui / session / dialogs
**/bin/data/**/imgui.ini
**/bin/data/**/imgui.*.ini
**/bin/data/**/imgui_*.ini
**/bin/data/**/appPrefs.json
**/bin/data/**/documentPrefs.json
**/bin/data/**/fileDialog*.txt
**/bin/data/**/uiScale.json
**/bin/data/**/.plotter_*_layout_version
**/bin/data/**/plotter_effects.json

# Machine- and user-specific settings (builtins live in code)
**/bin/data/**/MachinePrefs.json
**/bin/data/**/PenPresets.json
**/bin/data/**/PlotterZones.json

# Ephemeral inject snippets (keep named templates like pen_pump.gcode)
**/bin/data/**/snippets/inject_*.gcode

# Generated output / personal presets
**/bin/data/generated/
**/bin/data/**/Generated.gcode
**/bin/data/pen_presets/*
!**/bin/data/pen_presets/EVA3.json

